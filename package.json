{
  "name": "fable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:cards": "node scripts/generateSupportCards.mjs",
    "gen:perf": "node scripts/generateAbilityPerf.mjs",
    "gen:counts": "node scripts/generateAbilityCounts.mjs",
    "verify:sheet": "node sheet-source/verify.js --mode=I",
    "gen:pidols": "node scripts/generatePIdols.mjs",
    "gen:sprite": "node scripts/generateCardSprite.mjs",
    "gen:preevents": "node scripts/generatePreEventImages.mjs",
    "gen:all": "npm run sync:master && npm run gen:cards && npm run gen:perf && npm run gen:counts && npm run gen:pidols && npm run gen:sprite && npm run gen:preevents",
    "release": "npm run build && wrangler deploy",
    "sync:master": "node scripts/syncMaster.mjs",
    "sync:images": "node scripts/syncImagesFromDrive.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "modern-screenshot": "^4.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.4"
  }
}
